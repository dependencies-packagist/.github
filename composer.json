{
    "name": "dependencies/packagist",
    "description": "The Dependencies Package Repository.",
    "keywords": [
        "dependencies",
        "packagist"
    ],
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/dependencies-packagist",
    "authors": [
        {
            "name": "jundayw",
            "email": "jundayw@126.com"
        }
    ],
    "require": {
        "jundayw/tokenable": "^1.0",
        "nacosvel/2fa": "^1.0 || ^2.0"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.x-dev"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
